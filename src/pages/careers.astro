---
import Layout from '~/layouts/Layout.astro'
import Header from '~/components/Header.astro'
import ContactForm from '~/components/ContactForm.astro'
import Footer from '~/components/Footer.astro'
---

<Layout
  title="Careers — FENRIR"
  description="Join FENRIR. We're building AI-powered interview analysis for security, law enforcement, and defense."
>
  <Header />
  <main>
    <section class="pt-32 pb-20 lg:pt-40 lg:pb-28">
      <div class="mx-auto max-w-3xl px-6 lg:px-8">
        <p class="text-xs font-medium text-primary-bright tracking-widest uppercase mb-6">Careers</p>
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight tracking-tight text-foreground mb-8">
          Join us
        </h1>
        <p class="text-xl text-muted leading-relaxed mb-6">
          We're building the tools that close the gap between intelligence available in every
          investigative interview and intelligence actually extracted.
        </p>
        <p class="text-lg text-muted leading-relaxed mb-6">
          FENRIR sits at the intersection of AI, behavioral science, and national security —
          augmenting human judgment in the most demanding cognitive environments.
          We're assembling a team that understands the weight of that responsibility.
        </p>
        <p class="text-lg text-muted leading-relaxed mb-12">
          If that sounds like work worth doing, reach out.
        </p>

        <a
          href="/#contact"
          class="inline-flex items-center gap-2 text-sm font-medium text-primary-bright hover:text-secondary transition-colors duration-200"
        >
          Get in touch
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </section>

    <ContactForm />
  </main>
  <Footer />
</Layout>
