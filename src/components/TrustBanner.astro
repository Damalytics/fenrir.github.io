---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')

const pillars = [
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-6 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
    </svg>`,
    label: 'On-Premise',
    detail: 'Air-gapped when required',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
    </svg>`,
    label: 'EU AI Act',
    detail: 'High-risk compliant',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
    </svg>`,
    label: 'Zero Contamination',
    detail: 'Architectural guarantee',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
    </svg>`,
    label: 'Grounded Outputs',
    detail: 'Fully traceable',
  },
]
---

<section class="py-20 lg:py-24 border-t border-border/20">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-xs font-medium text-primary-bright tracking-widest uppercase mb-4">Trust</p>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mb-4">
        Secure by architecture
      </h2>
      <p class="text-base text-muted max-w-2xl mx-auto leading-relaxed">
        On-premise deployment is what makes the rest possible — quality and speed,
        without your transcripts ever leaving the room.
      </p>
    </div>

    <!-- Trust pillars -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 mb-10">
      {pillars.map((pillar) => (
        <div class="flex flex-col items-center text-center p-6 rounded-xl border border-border/30 bg-surface-card/20">
          <div class="text-primary-bright mb-3" set:html={pillar.icon} />
          <span class="text-sm font-semibold text-foreground mb-1">{pillar.label}</span>
          <span class="text-xs text-muted">{pillar.detail}</span>
        </div>
      ))}
    </div>

    <!-- Link to security page -->
    <div class="text-center">
      <a
        href={`${base}security`}
        class="inline-flex items-center gap-2 text-sm font-medium text-primary-bright hover:text-secondary transition-colors duration-200"
      >
        Learn more about our security approach
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
