---
const segments = [
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
    </svg>`,
    title: 'Security Clearance',
    description: 'Support for security clearances and personnel vetting. Ensure every required domain is covered, risk indicators are pursued, and assessments are defensible — regardless of which consultant conducts the interview.',
    context: 'Personnel vetting',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
    </svg>`,
    title: 'Law Enforcement',
    description: 'ORBIT-aligned analysis for criminal investigations. Score framework adherence, detect cognitive bias patterns, and produce structured interview reports — across 100% of interviews, not just the high-profile ones.',
    context: 'ORBIT framework compliance',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>`,
    title: 'Military & Defense',
    description: 'HUMINT collection support for source debriefs and tactical interviews. Maximize intelligence yield under operational tempo, track source reliability across sessions, and maintain Geneva Convention compliance.',
    context: 'FM 2-22.3 / NATO doctrine',
  },
]
---

<section id="solutions" class="py-24 lg:py-32 border-t border-border/20">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <!-- Section header -->
    <div class="max-w-2xl mb-16">
      <p class="text-xs font-medium text-primary-bright tracking-widest uppercase mb-4">Solutions</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground mb-6">
        Built for high-stakes interviews
      </h2>
      <p class="text-lg text-muted leading-relaxed">
        FENRIR is purpose-built for interviews where the stakes are highest — where missed
        intelligence has real consequences, reports can't wait, and the transcript can't
        leave your perimeter.
      </p>
    </div>

    <!-- Segment cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
      {segments.map((segment) => (
        <div class="group relative flex flex-col p-8 rounded-xl border border-border/50 bg-surface-card/30
                     hover:border-primary/30 hover:bg-surface-card/60
                     transition-all duration-300">
          <div class="text-primary-bright mb-6">{<Fragment set:html={segment.icon} />}</div>
          <h3 class="text-xl font-semibold text-foreground mb-3">{segment.title}</h3>
          <p class="text-sm text-muted leading-relaxed flex-1 mb-6">{segment.description}</p>
          <div class="flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-primary/60"></span>
            <span class="text-xs text-muted/70 font-medium">{segment.context}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
