---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')

const navItems = [
  { label: 'Product', href: `${base}product` },
  { label: 'Security', href: `${base}security` },
]
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <nav class="flex items-center justify-between h-18 lg:h-20">
      <!-- Logo -->
      <a href={base} class="flex items-center gap-3 group">
        <img src={`${base}fenrir-logo.svg`} alt="" class="h-14 w-auto transition-transform duration-300 group-hover:scale-105" />
        <span class="text-foreground font-semibold text-lg tracking-[0.15em] uppercase">
          Fenrir
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-muted text-sm font-medium tracking-wide hover:text-foreground transition-colors duration-200"
          >
            {item.label}
          </a>
        ))}
        <a
          href={`${base}#contact`}
          class="ml-2 inline-flex items-center px-5 py-2 text-sm font-medium rounded-md
                 bg-primary text-foreground
                 hover:bg-primary-bright transition-colors duration-200"
        >
          Book a Demo
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-toggle"
        class="md:hidden flex flex-col gap-1.5 p-2 -mr-2"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="block w-5 h-px bg-foreground transition-all duration-200 origin-center" id="bar1"></span>
        <span class="block w-5 h-px bg-foreground transition-all duration-200" id="bar2"></span>
        <span class="block w-5 h-px bg-foreground transition-all duration-200 origin-center" id="bar3"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-border/30">
    <div class="mx-auto max-w-7xl px-6 py-6 flex flex-col gap-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-muted text-base font-medium hover:text-foreground transition-colors duration-200 py-1"
        >
          {item.label}
        </a>
      ))}
      <a
        href={`${base}#contact`}
        class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium rounded-md
               bg-primary text-foreground mt-2
               hover:bg-primary-bright transition-colors duration-200"
      >
        Book a Demo
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!
  const toggle = document.getElementById('mobile-toggle')!
  const menu = document.getElementById('mobile-menu')!
  const bar1 = document.getElementById('bar1')!
  const bar2 = document.getElementById('bar2')!
  const bar3 = document.getElementById('bar3')!

  let isOpen = false

  // Scroll-based header background
  const updateHeader = () => {
    if (window.scrollY > 40) {
      header.classList.add('bg-surface/80', 'backdrop-blur-xl', 'border-border/20')
    } else {
      header.classList.remove('bg-surface/80', 'backdrop-blur-xl', 'border-border/20')
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true })
  updateHeader()

  // Mobile toggle
  toggle.addEventListener('click', () => {
    isOpen = !isOpen
    menu.classList.toggle('hidden', !isOpen)
    toggle.setAttribute('aria-expanded', String(isOpen))

    if (isOpen) {
      bar1.style.transform = 'rotate(45deg) translateY(3.5px)'
      bar2.style.opacity = '0'
      bar3.style.transform = 'rotate(-45deg) translateY(-3.5px)'
      header.classList.add('bg-surface/80', 'backdrop-blur-xl')
    } else {
      bar1.style.transform = ''
      bar2.style.opacity = ''
      bar3.style.transform = ''
      updateHeader()
    }
  })
</script>
