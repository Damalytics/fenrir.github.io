---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<section class="relative overflow-hidden flex items-center justify-center min-h-[85vh] pt-24 pb-16">
  <!-- Background wolf watermark (face shifted down so it sits behind the headline, not above it) -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none opacity-[0.03] pt-24 pb-16">
    <img src={`${base}fenrir-logo.svg`} alt="" class="w-[800px] h-auto translate-y-[22%]" />
  </div>

  <!-- Gradient orb -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full pointer-events-none"
       style="background: radial-gradient(circle, rgba(26,122,69,0.15) 0%, transparent 70%);">
  </div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
    <!-- Badge -->
    <p class="animate-fade-up text-xs font-medium text-primary-bright/70 tracking-[0.3em] uppercase mb-8">
      AI-Powered Interview Intelligence
    </p>

    <!-- Headline -->
    <h1 class="animate-fade-up delay-1 text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight text-foreground mb-6">
      AI for <span class="text-primary-bright">investigative</span>
      <br />
      interviews.
    </h1>

    <!-- Subtitle: value -->
    <p class="animate-fade-up delay-2 text-lg sm:text-xl text-foreground/90 max-w-3xl mx-auto leading-relaxed mb-3">
      Lift quality, cut report time from hours to minutes, all on infrastructure you control.
    </p>

    <!-- Subtitle: positioning -->
    <p class="animate-fade-up delay-2 text-base sm:text-lg text-muted max-w-2xl mx-auto leading-relaxed mb-4">
      Built for the interviews where missed intelligence has real consequences.
    </p>

    <!-- Sector line -->
    <p class="animate-fade-up delay-3 text-sm font-medium text-muted/60 tracking-widest uppercase mb-10">
      Security Clearance &middot; Law Enforcement &middot; Defense
    </p>

    <!-- CTAs -->
    <div class="animate-fade-up delay-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`${base}#contact`}
        class="inline-flex items-center px-7 py-3 text-sm font-semibold rounded-md
               bg-primary text-foreground
               hover:bg-primary-bright transition-all duration-200
               shadow-[0_0_24px_rgba(26,122,69,0.25)] hover:shadow-[0_0_32px_rgba(34,169,92,0.35)]"
      >
        Book a Demo
      </a>
      <a
        href={`${base}product`}
        class="inline-flex items-center gap-2 px-7 py-3 text-sm font-medium rounded-md
               border border-border text-muted
               hover:text-foreground hover:border-primary/50 transition-all duration-200"
      >
        Learn More
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-surface to-transparent"></div>
</section>
