---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')

const problems = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
    </svg>`,
    title: 'Intelligence left on the table',
    description: 'Coverage gaps, cognitive bias, and uneven performance between interviewers. The yield gap is real — and nobody tracks it.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`,
    title: 'Reports that eat the day',
    description: 'Hours of manual write-up per interview. Throughput capped by paperwork, not skill. In fixed-fee work, every wasted hour is margin lost.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
    </svg>`,
    title: 'Transcripts that can’t leave the room',
    description: 'Interview data is among the most sensitive there is. Cloud AI is off the table — and today that means either no AI at all, or unacceptable risk.',
  },
]
---

<section class="py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <!-- Section header -->
    <div class="max-w-2xl mb-16">
      <p class="text-xs font-medium text-primary-bright tracking-widest uppercase mb-4">The problem</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
        Three costs of the status quo
      </h2>
    </div>

    <!-- Problem cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {problems.map((problem, i) => (
        <div class={`group relative p-8 rounded-xl border border-border/50 bg-surface-card/30
                      hover:border-primary/30 hover:bg-surface-card/60
                      transition-all duration-300`}>
          <!-- Accent line -->
          <div class="absolute top-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-primary/40 to-transparent
                       opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <div class="text-primary-bright mb-5" set:html={problem.icon} />
          <h3 class="text-lg font-semibold text-foreground mb-3">{problem.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{problem.description}</p>
        </div>
      ))}
    </div>

    <!-- Link to product -->
    <a
      href={`${base}product`}
      class="inline-flex items-center gap-2 text-sm font-medium text-primary-bright hover:text-secondary transition-colors duration-200"
    >
      See how FENRIR solves this
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</section>
