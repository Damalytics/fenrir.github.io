---
const problems = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
    </svg>`,
    title: 'Coverage blind spots',
    description: 'Critical topics and leads go unexplored. Risk indicators are missed. No system flags what was left uncovered until it surfaces as an incident.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
    </svg>`,
    title: 'Cognitive bias',
    description: 'Confirmation bias, anchoring, and premature closure go undetected under cognitive load. Even experienced practitioners are affected — research confirms it.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
    </svg>`,
    title: 'Inconsistent quality',
    description: 'Performance varies by interviewer, session, and fatigue level. The gap between best and average is invisible and unmanaged — nobody measures it.',
  },
]
---

<section class="py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <!-- Section header -->
    <div class="max-w-2xl mb-16">
      <p class="text-xs font-medium text-primary-bright tracking-widest uppercase mb-4">The problem</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground mb-6">
        Intelligence left on the table
      </h2>
      <p class="text-lg text-muted leading-relaxed">
        Every investigative interview contains more intelligence than any single mind can capture.
        The gap between what's available and what's extracted is the single largest unaddressed
        capability deficit in security, law enforcement, and defense.
      </p>
    </div>

    <!-- Problem cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {problems.map((problem, i) => (
        <div class={`group relative p-8 rounded-xl border border-border/50 bg-surface-card/30
                      hover:border-primary/30 hover:bg-surface-card/60
                      transition-all duration-300`}>
          <!-- Accent line -->
          <div class="absolute top-0 left-8 right-8 h-px bg-gradient-to-r from-transparent via-primary/40 to-transparent
                       opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <div class="text-primary-bright mb-5" set:html={problem.icon} />
          <h3 class="text-lg font-semibold text-foreground mb-3">{problem.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{problem.description}</p>
        </div>
      ))}
    </div>

    <!-- Link to product -->
    <a
      href="/product"
      class="inline-flex items-center gap-2 text-sm font-medium text-primary-bright hover:text-secondary transition-colors duration-200"
    >
      See how FENRIR solves this
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</section>
