---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const currentYear = new Date().getFullYear()

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Product', href: `${base}product` },
      { label: 'Security', href: `${base}security` },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Contact', href: `${base}#contact` },
      { label: 'Privacy', href: '#' },
    ],
  },
]
---

<footer class="border-t border-border/20 py-16">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 sm:gap-8 mb-12">
      <!-- Logo column -->
      <div>
        <a href={base} class="flex items-center gap-3 mb-4">
          <img src={`${base}fenrir-logo.svg`} alt="" class="h-7 w-auto" />
          <span class="font-semibold text-sm tracking-[0.15em] uppercase text-foreground">Fenrir</span>
        </a>
        <p class="text-xs text-muted leading-relaxed max-w-xs">
          AI-powered analysis for investigative interviews.
          Augmenting human judgment, not replacing it.
        </p>
      </div>

      <!-- Link columns -->
      {columns.map((col) => (
        <div>
          <h3 class="text-xs font-semibold text-muted/60 tracking-widest uppercase mb-4">{col.title}</h3>
          <ul class="space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted hover:text-foreground transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-border/10">
      <p class="text-xs text-muted/40">
        &copy; {currentYear} Damalytics AB. All rights reserved.
      </p>
    </div>
  </div>
</footer>
